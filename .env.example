NODE_ENV=development
NEXT_PUBLIC_APP_NAME="NovaAssistant"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_ADMIN_EMAILS=admin@example.com

# Nova Assistant (valores en .env.local y en Vercel; nunca en el repositorio)
NOVAASSISTANT_POSTGRES_URL=
NOVAASSISTANT_POSTGRES_URL_NON_POOLING=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
BLOB_READ_WRITE_TOKEN=
# Cifrado de la clave de Gemini de cada persona (llave: 32 bytes en base64)
NOVA_LLAVE_CLAVES_ACTUAL=1
NOVA_LLAVE_CLAVES_V1=
# Dirección pública, notificaciones y tareas programadas
APP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
RECORDATORIOS_SECRETO=
NOVA_TICK_URL=
CRON_SECRET=
# Avisos de errores (opcional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
