NODE_ENV=development
NEXT_PUBLIC_APP_NAME="NovaAssistant"
NEXT_PUBLIC_APP_VERSION="0.1.0"
DATA_DIR=./data
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_ADMIN_EMAILS=admin@example.com

# Nova Assistant (valores en .env.local y en Vercel; nunca en el repositorio)
NOVAASSISTANT_POSTGRES_URL=
NOVAASSISTANT_POSTGRES_URL_NON_POOLING=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
BLOB_READ_WRITE_TOKEN=
